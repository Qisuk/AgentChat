{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Where agent settings edited in the UI are saved (relative to the app folder).
  "AgentsFile": "App_Data/agents.json",

  // Model endpoints agents can use. "OpenAICompatible" works with Ollama, LM Studio, vLLM, OpenAI,
  // OpenRouter, Groq, ... Keep API keys out of this file; use user secrets or environment variables, e.g.
  //   dotnet user-secrets set "Providers:1:ApiKey" "sk-..."
  "Providers": [
    {
      "Id": "ollama",
      "DisplayName": "Ollama (Docker)",
      "Kind": "OpenAICompatible",
      "BaseUrl": "http://localhost:11435/v1"
    },
    {
      // No LLM: replies with random extracts of the chat and calls tools at random. Instant and
      // deterministic (same chat, same reply). Models: short, medium, long (reply length).
      "Id": "random",
      "DisplayName": "Fast deterministic (no LLM)",
      "Kind": "Random"
    },
    {
      "Id": "openai",
      "DisplayName": "OpenAI",
      "Kind": "OpenAICompatible",
      "BaseUrl": "https://api.openai.com/v1"
    }
  ],

  // MCP servers whose tools agents can be given. Each tool appears as "<Name>__<tool>". Examples:
  //   { "Name": "fs", "Transport": "stdio", "Command": "npx", "Arguments": [ "-y", "@modelcontextprotocol/server-filesystem", "C:/temp" ] }
  //   { "Name": "web", "Transport": "http", "Url": "http://localhost:3001/mcp" }
  "McpServers": []
}
